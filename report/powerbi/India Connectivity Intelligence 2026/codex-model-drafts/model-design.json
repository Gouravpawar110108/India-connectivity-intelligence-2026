  "evidenceMaturity": "Draft",
  "architecture": {
    "pattern": "StarSchema",
    "factTables": [
      "FactConnectivity"
    ],
    "dimensionTables": [
      "DimPeriod",
      "DimGeography",
      "DimProvider",
      "DimMetric",
      "DimSource"
    ],
    "sourceNames": [
      "fact_connectivity",
      "dim_period",
      "dim_geography",
      "dim_provider",
      "dim_metric",
      "dim_source"
    ],
    "sourceProfiles": [
      {
        "name": "fact_connectivity",
        "path": "data/processed/fact_connectivity.csv",
        "extension": ".csv",
        "columns": [
          "observation_id",
          "metric_id",
          "period_end",
          "geography",
          "provider",
          "value",
          "unit",
          "source_id",
          "source_file",
          "source_page",
          "source_url",
          "scope_note"
        ]
      },
      {
        "name": "dim_period",
        "path": "data/processed/dim_period.csv",
        "extension": ".csv",
        "columns": [
          "period_key",
          "period_end"
        ]
      },
      {
        "name": "dim_geography",
        "path": "data/processed/dim_geography.csv",
        "extension": ".csv",
        "columns": [
          "geography_key",
          "geography",
          "geography_type"
        ]
      },
      {
        "name": "dim_provider",
        "path": "data/processed/dim_provider.csv",
        "extension": ".csv",
        "columns": [
          "provider_key",
          "provider"
        ]
      },
      {
        "name": "dim_metric",
        "path": "data/processed/dim_metric.csv",
        "extension": ".csv",
        "columns": [
          "metric_key",
          "metric_id",
          "metric_name",
          "default_unit"
        ]
      },
      {
        "name": "dim_source",
        "path": "data/processed/dim_source.csv",
        "extension": ".csv",
        "columns": [
          "source_key",
          "source_id",
          "source_file",
          "source_url"
        ]
      }
    ],
